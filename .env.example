# Copie estos valores en su entorno local. No incluya secretos reales en este archivo.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=citas_app
DB_USERNAME=CAMBIAR_EN_ENTORNO
DB_PASSWORD=CAMBIAR_EN_ENTORNO
JWT_SECRET=CONFIGURAR_UN_SECRETO_DE_AL_MENOS_32_BYTES_EN_EL_ENTORNO
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
CORS_ALLOWED_ORIGINS=http://localhost:5173

# S5 / WF-001: clave de máquina para n8n (>= 32 caracteres). Vacía = endpoints de automatización cerrados.
AUTOMATION_API_KEY=
REMINDER_DEFAULT_WINDOW_HOURS=24
REMINDER_MAX_ATTEMPTS=3
# S6 / WF-002: webhook de n8n (https) y secreto compartido (>= 32 caracteres) de la credencial Header Auth.
N8N_STATUS_WEBHOOK_URL=
N8N_STATUS_WEBHOOK_SECRET=
N8N_EVENT_MAX_ATTEMPTS=5
