    {
      "id": "e97289ce-5dbc-4d3f-8932-b7819fea5068",
      "name": "Normalizar y validar evento",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        224,
        512
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "n-event-id",
              "name": "eventId",
              "type": "string",
              "value": "={{ $json.body?.eventId ?? \"\" }}"
            },
            {
              "id": "n-event-key",
              "name": "eventKey",
              "type": "string",
              "value": "={{ ($json.body?.eventType ?? \"\") + \":\" + ($json.body?.status ?? \"\") }}"
            },
            {
              "id": "n-first-name",
              "name": "patientFirstName",
              "type": "string",
              "value": "={{ $json.body?.patient?.firstName ?? \"\" }}"
            },
            {
              "id": "n-email",
              "name": "patientEmail",
              "type": "string",
              "value": "={{ $json.body?.patient?.email ?? \"\" }}"
            },
            {
              "id": "n-specialty",
              "name": "specialtyName",
              "type": "string",
              "value": "={{ $json.body?.appointment?.specialtyName ?? \"\" }}"
            },
            {
              "id": "n-professional",
              "name": "professionalName",
              "type": "string",
              "value": "={{ $json.body?.appointment?.professionalName ?? \"\" }}"
            },
            {
              "id": "n-location",
              "name": "locationName",
              "type": "string",
              "value": "={{ $json.body?.appointment?.locationName ?? \"\" }}"
            },
            {
              "id": "n-when",
              "name": "startsAtLocal",
              "type": "string",
              "value": "={{ $json.body?.appointment?.startsAt ? DateTime.fromISO($json.body.appointment.startsAt, { zone: \"utc\" }).setZone(\"America/Bogota\").toFormat(\"dd/MM/yyyy HH:mm\") : \"\" }}"
            },
            {
              "id": "n-reason",
              "name": "decisionReason",
              "type": "string",
              "value": "={{ $json.body?.decisionReason ?? \"\" }}"
            },
            {
              "id": "n-test-recipient",
              "name": "testRecipient",
              "type": "string",
              "value": ""
            },
            {
              "id": "n-valid",
              "name": "valid",
              "type": "boolean",
              "value": "={{ $json.body?.schemaVersion === 1 && /^[0-9a-f-]{36}$/i.test($json.body?.eventId ?? \"\") && [\"SPECIALIZED_DECISION:APPROVED\",\"SPECIALIZED_DECISION:REJECTED\",\"RESCHEDULE_DECISION:APPROVED\",\"RESCHEDULE_DECISION:REJECTED\",\"CANCELLATION:CANCELLED\"].includes(($json.body?.eventType ?? \"\") + \":\" + ($json.body?.status ?? \"\")) && /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test($json.body?.patient?.email ?? \"\") && !!$json.body?.appointment?.startsAt }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "c1a6b4f9-0a42-4114-85da-946d1fc32a54",
      "name": "¿Payload válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        448,
        512
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.valid }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "e2da5e9b-0bba-4bda-8176-0e3bf5987548",
      "name": "Ramificar por tipo y estado",
