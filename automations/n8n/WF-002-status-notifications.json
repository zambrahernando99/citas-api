      "typeVersion": 3.4,
      "position": [
        672,
        336
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "outputKey": "SPECIALIZED_DECISION:APPROVED",
              "renameOutput": true,
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.eventKey }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "SPECIALIZED_DECISION:APPROVED"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "SPECIALIZED_DECISION:REJECTED",
              "renameOutput": true,
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.eventKey }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "SPECIALIZED_DECISION:REJECTED"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "RESCHEDULE_DECISION:APPROVED",
              "renameOutput": true,
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.eventKey }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "RESCHEDULE_DECISION:APPROVED"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "RESCHEDULE_DECISION:REJECTED",
              "renameOutput": true,
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.eventKey }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "RESCHEDULE_DECISION:REJECTED"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "CANCELLATION:CANCELLED",
              "renameOutput": true,
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.eventKey }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "CANCELLATION:CANCELLED"
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {}
      }
    },
